# Copy to backend/.env and fill in. Never commit the real .env.

# REQUIRED: random secret, min 32 chars.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# SQLite file location (mount a persistent volume in production)
DATABASE_PATH=./safebite.db

# Optional: full path to tesseract if it's not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Set to 1 when running behind a reverse proxy / load balancer (uses X-Forwarded-For)
TRUST_PROXY=0

# Rate limits (flask-limiter syntax). Use redis://host:6379 for multi-worker/multi-instance setups.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5 per minute
LOGIN_IP_RATE_LIMIT=30 per minute
REGISTER_RATE_LIMIT=10 per hour
ANALYZE_RATE_LIMIT=60 per minute
OCR_RATE_LIMIT=10 per minute

TOKEN_EXPIRY_HOURS=24
MAX_REQUEST_MB=8
MAX_INGREDIENT_TEXT_CHARS=5000
MAX_IMAGE_PIXELS=25000000

# Local development only. NEVER enable in production.
FLASK_DEBUG=0
